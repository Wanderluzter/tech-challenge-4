# ---------------------------------------------------------------- LLM (geração)
# Qualquer API compatível com a da OpenAI. Sem chave nem endpoint, o sistema roda em
# modo extrativo (recupera e mostra evidências, sem síntese).
LLM_API_KEY=
# Nome do modelo no seu provedor (obrigatório quando há chave). Consulte a lista atual
# de modelos do provedor; um modelo pequeno e barato é suficiente.
LLM_MODEL=
# Deixe vazio para a OpenAI. Outros provedores:
#   Google Gemini: https://generativelanguage.googleapis.com/v1beta/openai/
#   Groq:          https://api.groq.com/openai/v1
#   Ollama local:  http://localhost:11434/v1   (LLM_API_KEY pode ficar vazio)
LLM_BASE_URL=
LLM_TEMPERATURE=0.1
# auto | openai_compat | extractive
LLM_PROVIDER=auto

# ---------------------------------------------------------------- Embeddings
# e5  = intfloat/multilingual-e5-small (padrão; baixa o modelo do Hugging Face)
# lsa = backend offline para testes (TF-IDF + SVD), sem downloads
EMBEDDING_BACKEND=e5
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# ---------------------------------------------------------------- Recuperação
TOP_K=12
DENSE_CANDIDATES=40
BM25_CANDIDATES=40
MMR_LAMBDA=0.7
MIN_EVIDENCES=3
# Vazio = usa o limiar calibrado por `python -m voc_rag.cli eval --write`
MIN_SIMILARITY=
# on | off — remove o vocabulário analítico da pergunta antes da busca
QUERY_FOCUS=on
